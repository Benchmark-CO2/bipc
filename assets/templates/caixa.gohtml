{{define "report"}}
<html>
<head>
	<meta charset="utf-8">
	<style>{{.FontFaceCSS}}</style>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/d3-regression@2.2.0/dist/d3-regression.min.js"></script>

	<style>
		* {
			box-sizing: border-box;
		}

		body {
			font-family: 'Roboto Flex';
		}

		h1 {
			color: #187B8B;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 18px;
			font-style: normal;
			font-weight: 600;
			line-height: 18px;
			letter-spacing: -0.18px;
			margin-top: 20px;
		}

		h2 {
			color: #187B8B;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 12px;
			font-style: normal;
			font-weight: 600;
			line-height: 12px;
			letter-spacing: -0.12px;
		}

		h3 {
			color: #121F21;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 9.5px;
			font-style: normal;
			font-weight: 600;
			line-height: 12px;
			letter-spacing: -0.09px;
		}

		.text {
			color: #000;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 7px;
			font-style: normal;
			font-weight: 400;
			line-height: 7px;
			letter-spacing: -0.07px;
		}

		.input {
			display: flex;
			width: var(--input-width, 90px);
			flex-direction: column;
			align-items: flex-start;
			gap: 1px;
		}

		.label {
			min-width: 30px;
			align-self: stretch;
			color: #71717A;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 7px;
			font-style: normal;
			font-weight: 400;
			line-height: 7.5px;
			letter-spacing: -0.06px;
		}

		.input-box {
			display: flex;
			min-width: 30px;
			min-height: 18px;
			padding: 4px;
			align-items: center;
			gap: 4px;
			align-self: stretch;
			border: 1px solid #E4E4E7;
			background: #FFF;
		}

		.input-text {
			color: #121F21;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 7px;
			font-style: normal;
			font-weight: 400;
			letter-spacing: -0.07px;
		}

		.bigNumber {
			color: #187B8B;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 24px;
			font-style: normal;
			font-weight: 700;
			line-height: normal;
			letter-spacing: -0.24px;
		}

		/* chart */

		#chart-container {
    		max-width: 600px;
		}
		.legend {
			display: flex;
			flex-wrap: wrap;
			gap: 24px;
			margin-top: 14px;
			padding-top: 14px;
			border-top: 1px solid #e5e5e5;
		}
		.legend-item {
			display: flex;
			align-items: center;

			gap: 6px;
			
			color: #121F21;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 7px;
			font-style: normal;
			font-weight: 700;
			letter-spacing: -0.06px;
		}
		.legend-dot {
			width: 9px;
			height: 9px;
			border-radius: 50%;
			display: inline-block;
		}
		.segment-label {
			fill: #ffffff;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 8px;
			font-style: normal;
			font-weight: 700;
			letter-spacing: -0.08px;
		}
	</style>
</head>
<body>
	<h1>Dados do projeto</h1>
	<p class="text">Informações fundamentais e características de identificação do projeto, incluindo localização, dimensões principais e fase do projeto.</p>

	<div style="display: flex; align-items: flex-start; gap: 15px; margin-bottom: 7.5px;">
		<div class="input" style="--input-width: 95px;">
			<div class="label">SIOPI</div>
			<div class="input-box">
				<div class="input-text">{{.ReportData.Siopi}}</div>
			</div>
		</div>

		<div class="input" style="--input-width: 105px;">
			<div class="label">Identificador do projeto (APF)</div>
			<div class="input-box">
				<div class="input-text">{{.ReportData.Apf}}</div>
			</div>
		</div>
	</div>

	<div style="display: flex;align-items: flex-start; align-content: flex-start; gap: 7.5px 15px; align-self: stretch; flex-wrap: wrap;">
		<div class="input" style="--input-width: 150px;">
			<div class="label">Nome do projeto</div>
			<div class="input-box">
				<div class="input-text">{{.ReportData.Name}}</div>
			</div>
		</div>

		<div class="input" style="--input-width: 50px;">
			<div class="label">Tipo do edifício</div>
			<div class="input-box">
				<div class="input-text">Torre</div>
			</div>
		</div>

		<div class="input" style="--input-width: 43px;">
			<div class="label">Tipo do uso</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 60px;">
			<div class="label">Fase do projeto</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 65px;">
			<div class="label">Número de UH total</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 50px;">
			<div class="label">Número de UC</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 65px;">
			<div class="label">Área const. UC (m²)</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 70px;">
			<div class="label">Área const. total (m²)</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 150px;">
			<div class="label">Rua / Avenida</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 50px;">
			<div class="label">CEP</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 40px;">
			<div class="label">Número</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 150px;">
			<div class="label">Bairro</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 150px;">
			<div class="label">Cidade</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>

		<div class="input" style="--input-width: 30px;">
			<div class="label">Estado</div>
			<div class="input-box">
				<div class="input-text"></div>
			</div>
		</div>
	</div>

	<!--
	<h1>Percentual de rastreabilidade dos dados</h1>

	<div style="display: flex; align-items: flex-start; gap: 5px; align-self: stretch;">
		<div id="chart-container">
			<svg id="chart"></svg>
			<div class="legend" id="legend"></div>
		</div>
		<div style="display: flex; flex-direction: column; align-items: center; gap: 2px; padding-left: 15px; margin-left: 15px; border-left: 1px solid #E4E4E7;">
			<div class="bigNumber">{{.ReportData.SourcesTotal}}%</div>
			<div class="text" style="color: #187B8B">de rastreabilidade</div>
		</div>
	</div>
	-->

	<h1>Resumo dos resultados do Benchmark</h1>

	<div style="display: flex; justify-content: space-between; align-items: stretch; align-self: stretch;">
		<div style="display: flex; flex-direction: column; align-items: center; gap: 7.5px; flex: 1;">
			<h2 style="align-self: start; margin-bottom: 0px;">Emissões de CO₂</h2>
			<h3 style="align-self: start; margin-top: 0px;">Total de Emissões de Carbono do edifício (Kg CO₂)</h3>

			<div style="display: flex;height: 52px; align-items: flex-start; gap: 7.5px; align-self: stretch;">
				<div style="display: flex; padding: 5px; flex-direction: column; align-items: flex-start; gap: 5px; flex: 1 0 0; border: 1px solid #6C9EE0;">
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #6C9EE0; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Melhor cenário (Kg CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							128.577,25
						</div>
					</div>
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #6C9EE0; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Melhor cenário (Kg/m² CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							45,83
						</div>
					</div>
				</div>

				<div style="display: flex; padding: 5px; flex-direction: column; align-items: flex-start; gap: 5px; flex: 1 0 0; border: 1px solid #E0756C;">
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #E0756C; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Pior cenário (Kg CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							211.205,95
						</div>
					</div>
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #E0756C; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Pior cenário (Kg/m² CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							75,28
						</div>
					</div>
				</div>

				<div style="display: flex; padding: 5px; flex-direction: column; align-items: flex-start; gap: 5px; flex: 1 0 0; border: 1px solid #63B332;">
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #63B332; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Valor de Ref. - Total (Kg CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							211.205,95
						</div>
					</div>
					<div style="display: flex; height: 18.5px; flex-direction: column; align-items: flex-start; gap: 2px;">
						<div style="color: #63B332; font-feature-settings: 'calt' off; font-size: 6px; font-style: normal; font-weight: 400; line-height: 7.5px; letter-spacing: -0.6px;">
							Valor de Ref. - Benchmark (Kg/m² CO₂)
						</div>
						<div style="color: #121F21; font-feature-settings: 'calt' off; font-size: 7px; font-style: normal; font-weight: 400; line-height: 9px; letter-spacing: -0.14px;">
							75,28
						</div>
					</div>
				</div>
			</div>

		</div>

		<div style="width: 1px; background: #E4E4E7; margin: 0 16px"></div>

		<div style="display: flex; width: 325px; flex-direction: column; align-items: center; gap: 7.5px; flex: 1">
			<h2 style="align-self: start; margin-bottom: 0px;">Consumo de energia</h2>
			<h3 style="align-self: start; margin-top: 0px;">Consumo total de energia do edifício (MJ)</h3>
		</div>
</div>
	
	
	<script>
		window.chartsReady = false;

		const data = {{.JSONData}};

		function renderChartRastreabilidade(data) {
			const width = 600;
			const barHeight = 12;
			const height = barHeight;
			
			const svg = d3.select("#chart")
			.attr("width", width)
			.attr("height", height)
			.attr("viewBox", `0 0 ${width} ${height}`);
			
			const total = d3.sum(data.sources, d => d.value);
			const xScale = d3.scaleLinear()
			.domain([0, total])
			.range([0, width]);
			
			let cumulative = 0;
			const segments = data.sources.map(d => {
			const seg = {
				...d,
				x0: cumulative,
				x1: cumulative + d.value
			};
			cumulative += d.value;
			return seg;
			});
			
			const gap = 3; // small gap between segments
			
			const groups = svg.selectAll("g.segment")
			.data(segments)
			.enter()
			.append("g")
			.attr("class", "segment");
			
			groups.append("rect")
			.attr("x", d => xScale(d.x0) + (d.x0 === 0 ? 0 : gap / 2))
			.attr("y", 0)
			.attr("width", d => Math.max(0, xScale(d.x1) - xScale(d.x0) - (d.x0 === 0 ? gap / 2 : gap)))
			.attr("height", barHeight)
			.attr("rx", 3)
			.attr("fill", d => d.color);
			
			groups.append("text")
			.attr("class", "segment-label")
			.attr("x", d => xScale(d.x0) + (xScale(d.x1) - xScale(d.x0)) / 2)
			.attr("y", barHeight / 2)
			.attr("text-anchor", "middle")
			.attr("dominant-baseline", "central")
			.text(d => `${d.value}%`);
			
			// Legend
			const legend = d3.select("#legend");
			const legendItems = legend.selectAll(".legend-item")
			.data(data.sources)
			.enter()
			.append("div")
			.attr("class", "legend-item");
			
			legendItems.append("span")
			.attr("class", "legend-dot")
			.style("background-color", d => d.color);
			
			legendItems.append("span")
			.text(d => `${d.value}% ${d.label}`);

		}
		renderChartRastreabilidade(data);

		window.chartsReady = true;
	</script>
</body>
</html>
{{ end }}

{{define "cover"}}
<html>
<head>
	<meta charset="utf-8">
	<style>{{.FontFaceCSS}}</style>
	<style>
		@page :first {
			size: A4;
			margin: 0;
  		}

		* {
			box-sizing: border-box;
		}

		html, body {
			margin: 0;
			padding: 0;
			width: 210mm;
			height: 297mm;

			font-family: 'Roboto Flex';
  		}

		.capa {
			width: 100%;
			height: 100%;
			overflow: hidden;
		}

		.capa > svg {
			position: absolute;
			top: 0;
			right: 0;
			height: 100%;
			width: 220px;
			z-index: 0;
		}

		.header {
			display: flex;
			width: 680px;
			flex-direction: column;
			justify-content: center;
			align-items: flex-start;
			margin: 30px 20px;
		}

		h1 {
			color: #187B8B;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 18px;
			font-style: normal;
			font-weight: 700;
			line-height: 18px;
			letter-spacing: -0.18px;
			margin: 0;
		}

		h2 {
			color: #121F21;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 16px;
			font-style: normal;
			font-weight: 700;
			line-height: 16px;
			letter-spacing: -0.16px;
			margin-top: 30px;
		}

		.label {
			color: #71717A;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 8px;
			font-style: normal;
			font-weight: 400;
			line-height: 8px;
			letter-spacing: -0.08px;
			margin-bottom: 2px;
		}

		.identifier {
			color: #121F21;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 12px;
			font-style: normal;
			font-weight: 700;
			line-height: 12px;
			letter-spacing: -0.12px;
		}

		.validation {
			display: flex;
			width: 150px;
			height: 130px;
			padding: 5px;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 5px;

			border-radius: 4px;
			border: 1px solid #E4E4E7;
			background: #FBFEFE;

			margin-top: auto;
		}

		.validation-text {
			color: #121F21;
			text-align: center;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 9px;
			font-style: normal;
			font-weight: 400;
			line-height: normal;
			letter-spacing: -0.09px;
		}

		.validation-text span {
			color: #078398;
		}

		.container {
			width: calc(100% - 220px);
			display: flex;
			justify-content: center;
			align-items: center;
			flex-direction: column;
			position: absolute;
			bottom: 25px;
		}

		#date {
			color: #187B8B;
			font-feature-settings: 'calt' off;
			font-family: "Roboto Flex";
			font-size: 12px;
			font-style: normal;
			font-weight: 600;
			line-height: 12px;
			letter-spacing: -0.12px;
			margin-top: 25px;
		}
	</style>
</head>
<body>
	<div class="capa">
		<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="443" height="2039" viewBox="0 0 443 2039" preserveAspectRatio="xMidYMid slice" fill="none">
		<rect width="443" height="2039" fill="url(#pattern0_3204_7659)"/>
		<defs>
		<pattern id="pattern0_3204_7659" patternUnits="userSpaceOnUse" patternTransform="matrix(22.4 0 0 44.8 214.5 1012.5)" preserveAspectRatio="none" viewBox="0 0 56 112" width="1" height="1">
		<use xlink:href="#pattern0_3204_7659_inner" transform="translate(-56 0)"/>
		<g id="pattern0_3204_7659_inner">
		<path d="M23.8889 19.771C23.8889 18.0003 25.3813 16.5649 27.2222 16.5649H30.5556C33.0102 16.5649 35 18.4788 35 20.8397V27.2519H28.3333C25.8787 27.2519 23.8889 25.338 23.8889 22.9771V19.771Z" fill="#63B332"/>
		<path d="M8.33333 0H21.6667V8.01527H10.5556C9.32826 8.01527 8.33333 8.97222 8.33333 10.1527V24.8473C8.33333 26.0278 9.32826 26.9847 10.5556 26.9847H21.6667V35H8.33333C3.73096 35 0 31.4114 0 26.9847V8.01527C0 3.58856 3.73096 0 8.33333 0Z" fill="#63B332"/>
		</g>
		<use xlink:href="#pattern0_3204_7659_inner" transform="translate(-28 56)"/>
		<use xlink:href="#pattern0_3204_7659_inner" transform="translate(28 56)"/>
		</pattern></defs>
		</svg>

		<div class="header">
			<svg width="215" height="130" viewBox="0 0 215 130" fill="none" xmlns="http://www.w3.org/2000/svg">
